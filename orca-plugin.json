{
  "manifestVersion": 1,
  "id": "wakatime",
  "publisher": "nknwns",
  "name": "WakaTime",
  "version": "0.1.1",
  "description": "Automatic time tracking with WakaTime: open files, saves, terminal, built-in browser, and AI agent time.",
  "author": { "name": "nknwns", "url": "https://github.com/nknwns" },
  "repository": "https://github.com/nknwns/orca-wakatime",
  "engines": { "orca": ">=1.4.222" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      { "id": "wakatime.status", "title": "WakaTime: Status" },
      { "id": "wakatime.today", "title": "WakaTime: Today's Time" },
      { "id": "wakatime.dashboard", "title": "WakaTime: Open Dashboard" },
      { "id": "wakatime.pause", "title": "WakaTime: Pause Tracking" },
      { "id": "wakatime.resume", "title": "WakaTime: Resume Tracking" }
    ],
    "events": [{ "on": "agent.status.changed" }, { "on": "worktree.created" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "storage" },
    { "kind": "events:subscribe" }
  ]
}
